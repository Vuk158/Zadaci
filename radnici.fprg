    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="t, s" type="Real" array="False" size=""/>
            <declare name="n, m" type="Integer" array="False" size=""/>
            <input variable="n"/>
            <input variable="s"/>
            <input variable="m"/>
            <assign variable="t" expression="(n*s)/(m+n)"/>
            <output expression="t" newline="True"/>
        </body>
    </function>
</flowgorithm>
