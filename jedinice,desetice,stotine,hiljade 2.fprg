    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="H, S, D, J, n, m" type="Integer" array="False" size=""/>
            <input variable="n"/>
            <assign variable="J" expression="n%10"/>
            <assign variable="n" expression="n/10"/>
            <assign variable="D" expression="n%10"/>
            <assign variable="n" expression="n/10"/>
            <assign variable="S" expression="n%10"/>
            <assign variable="n" expression="n/10"/>
            <assign variable="H" expression="n%10"/>
            <assign variable="m" expression="H*100+S*10+J*1"/>
            <output expression="m" newline="True"/>
        </body>
    </function>
</flowgorithm>
