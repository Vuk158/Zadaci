<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="razlika sume krajnjih i sredisnjih cifara"/>
        <attribute name="authors" value="vuk"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-23 01:30:01 PM"/>
