        <attribute name="edited" value="dnVrO1BDLTA2OzIwMjYtMDktMjM7MDE6Mjg6MjkgUE07MTt2dWs7UEMtMDY7MjAyNi0wOS0yMzswMTowODoyNSBQTTtwcm9penZvZCBjaWZhcmEuZnByZzs2MDg4"/>
        <attribute name="edited" value="dnVrO1BDLTA2OzIwMjYtMDktMjM7MDE6MzA6MDEgUE07MTsyMDE3"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="broj, H, S, D, J, suma" type="Integer" array="False" size=""/>
            <input variable="broj"/>
            <assign variable="H" expression="broj/1000"/>
            <assign variable="broj" expression="broj%1000"/>
            <assign variable="S" expression="broj/100"/>
            <assign variable="broj" expression="broj%100"/>
            <assign variable="D" expression="broj/10"/>
            <assign variable="broj" expression="broj%10"/>
            <assign variable="J" expression="broj/1"/>
            <assign variable="suma" expression="(H+J)-(S+D)"/>
            <output expression="suma" newline="True"/>
        </body>
    </function>
</flowgorithm>
