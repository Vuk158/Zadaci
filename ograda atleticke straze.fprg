    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="r, x, do, a" type="Integer" array="False" size=""/>
            <input variable="r"/>
            <input variable="x"/>
            <assign variable="do" expression="8*(r+x)"/>
            <assign variable="a" expression="2*x+2*r"/>
