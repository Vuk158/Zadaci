    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b, c, O, P" type="Integer" array="False" size=""/>
            <input variable="a"/>
            <input variable="b"/>
            <input variable="c"/>
            <assign variable="O" expression="a+b+c"/>
            <assign variable="P" expression="(a*b)/2"/>
            <output expression="O" newline="True"/>
            <output expression="P" newline="True"/>
        </body>
    </function>
</flowgorithm>
